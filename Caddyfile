{
    email admin@enfyjobs.com

    # ── ACME CA: Buypass Go (bypasses Let's Encrypt rate-limit history) ──
    # Buypass is browser-trusted, free, uses same HTTP-01 challenge as LE.
    # Switch back to default (Let's Encrypt) by removing the acme_ca line
    # after all certs are successfully issued.
    acme_ca https://api.buypass.com/acme/directory

    on_demand_tls {
        ask http://backend:5000/api/auth/check-ssl-domain
    }
}

# ─── 1. Single Central Backend API ──────────────────────────────────
api.enfyjobs.com {
    encode gzip zstd
    reverse_proxy backend:5000
}

# ─── 2. Root Frontend Domain ─────────────────────────────────────────
enfyjobs.com {
    encode gzip zstd
    reverse_proxy frontend:3000
}

# ─── 3. Dynamic Multi-Tenant Subdomains & Custom Client Domains ──────
:443 {
    tls {
        on_demand
    }
    encode gzip zstd
    reverse_proxy frontend:3000
}
