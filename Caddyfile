{
    email admin@enfyjobs.com
    on_demand_tls {
        ask http://backend:5000/api/auth/check-ssl-domain
    }
}

# ─── 1. Single Central Backend API ──────────────────────────────────
api.enfyjobs.com {
    encode gzip zstd
    reverse_proxy backend:5000
}

# ─── 2. Root Frontend Domain ─────────────────────────────────────────
enfyjobs.com {
    encode gzip zstd
    reverse_proxy frontend:3000
}

# ─── 3. Dynamic Multi-Tenant Subdomains & Custom Client Domains ──────
:443 {
    tls {
        on_demand
    }
    encode gzip zstd
    reverse_proxy frontend:3000
}
