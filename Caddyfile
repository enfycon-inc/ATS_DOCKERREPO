{
    email admin@enfyjobs.com
    on_demand_tls {
        ask http://backend:5000/
    }
}

# ─── 1. Single Central Backend API ──────────────────────────────────
api.enfyjobs.com {
    encode gzip zstd
    reverse_proxy backend:5000
}

# ─── 2. Root & Primary Workspace Frontend Domains ───────────────────
enfyjobs.com, deb.enfyjobs.com {
    encode gzip zstd
    reverse_proxy frontend:3000
}

# ─── 3. Dynamic Multi-Tenant Subdomains & Custom Domains ─────────────
https:// {
    tls {
        on_demand
    }
    encode gzip zstd
    reverse_proxy frontend:3000
}
