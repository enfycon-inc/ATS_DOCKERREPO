{
    email admin@enfyjobs.com
    on_demand_tls {
        import /etc/caddy/upstreams/ask.caddy
    }
}

# ─── 1. Single Central Backend API ──────────────────────────────────
api.enfyjobs.com {
    encode gzip zstd
    import /etc/caddy/upstreams/backend.caddy
}

# ─── 2. Root Frontend Domain ─────────────────────────────────────────
enfyjobs.com {
    encode gzip zstd
    import /etc/caddy/upstreams/frontend.caddy
}

# ─── 3. Dynamic Multi-Tenant Subdomains & Custom Client Domains ──────
:443 {
    tls {
        on_demand
    }
    encode gzip zstd
    import /etc/caddy/upstreams/frontend.caddy
}
