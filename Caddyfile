{
    email admin@enfyjobs.com
    on_demand_tls {
        import /etc/caddy/upstreams/ask.caddy
    }
}

# ─── 1. Single Central Backend API ──────────────────────────────────
api.enfyjobs.com {
    encode gzip zstd
    import /etc/caddy/upstreams/backend.caddy
}

# ─── 2. Root Frontend Domain ─────────────────────────────────────────
enfyjobs.com {
    encode gzip zstd
    import /etc/caddy/upstreams/frontend.caddy
}

# ─── 3. Keycloak Identity Provider ──────────────────────────────────
auth.enfyjobs.com {
    encode gzip zstd
    reverse_proxy keycloak:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-Port 443
    }
}

# ─── 4. Database Web Console (pgAdmin 4) ────────────────────────────
db.enfyjobs.com, db.enfyjoobs.com {
    encode gzip zstd
    reverse_proxy pgadmin:80 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
    }
}

# ─── 5. Dynamic Multi-Tenant Subdomains & Custom Client Domains ──────
:443 {
    tls {
        on_demand
    }
    encode gzip zstd
    import /etc/caddy/upstreams/frontend.caddy
}
