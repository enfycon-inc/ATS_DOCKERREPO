{
    email admin@enfyjobs.com
    on_demand_tls {
        ask http://backend:5000/
    }
}

# ─── 1. Single Central Backend API ──────────────────────────────────
api.enfyjobs.com {
    encode gzip zstd
    reverse_proxy backend:5000
}

# ─── 2. Root Frontend Domain ─────────────────────────────────────────
enfyjobs.com {
    encode gzip zstd
    reverse_proxy frontend:3000
}

# ─── 3. All Multi-Tenant Subdomains (*.enfyjobs.com) ─────────────────
*.enfyjobs.com {
    tls {
        on_demand
    }
    encode gzip zstd
    reverse_proxy frontend:3000
}
