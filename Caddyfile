{
    # Global Caddy Configuration
    email admin@enfyjobs.com
}

# ─── API Subdomain ───────────────────────────────────────────────────
api.enfyjobs.com {
    encode gzip zstd
    reverse_proxy backend:5000
}

# ─── Root and Wildcard Subdomains (*.enfyjobs.com & enfyjobs.com) ─────
*.enfyjobs.com, enfyjobs.com {
    encode gzip zstd

    # Route backend API and Swagger docs directly to NestJS
    handle /api/* {
        reverse_proxy backend:5000
    }

    handle /docs* {
        reverse_proxy backend:5000
    }

    # Route all other web traffic to Next.js Frontend
    handle {
        reverse_proxy frontend:3000
    }
}
